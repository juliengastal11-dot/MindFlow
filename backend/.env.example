# ---- MindFlow Business — configuration backend ----
# Copiez ce fichier en `.env` et adaptez les valeurs.

# Clé secrète (signature des jetons + chiffrement des clés IA / Google).
# Si vide, une clé est générée automatiquement dans backend/data/.secret_key
SECRET_KEY=

# Base de données. SQLite par défaut (fichier backend/data/mindflow.db).
# Exemple PostgreSQL : postgresql+psycopg://user:motdepasse@hote:5432/mindflow
DATABASE_URL=

# Origines autorisées (CORS), séparées par des virgules — inutile si le backend sert aussi le front
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# URL publique du front (redirection après connexion Google Calendar).
# Sur Railway, laissez vide : le domaine public est détecté automatiquement.
FRONTEND_URL=http://localhost:3000

# Cookies "secure" : automatique (true dès que FRONTEND_URL est en https)
COOKIE_SECURE=

# Durée de validité des sessions (jours)
TOKEN_DAYS=30

# ---- Google Calendar (optionnel) ----
# Console Google Cloud → Identifiants → ID client OAuth 2.0 (application Web)
# URI de redirection autorisée : http://localhost:8000/api/oauth/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optionnel : déduit automatiquement (localhost:8000 en local, FRONTEND_URL en production)
GOOGLE_REDIRECT_URI=

# ---- IA (optionnel) ----
# Clé serveur utilisée quand l'utilisateur n'a pas renseigné sa propre clé.
# Sans aucune clé, un moteur heuristique (mots-clés) prend le relais.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash

# Créer le compte démo au démarrage (demo@mindflow.app / demo1234).
# Par défaut : oui en local, non en production.
SEED_DEMO=true

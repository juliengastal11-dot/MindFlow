# Variables lues par docker-compose.yml — copier en `.env` À LA RACINE du projet.

# Nom de domaine pointant vers le serveur (sans https://)
DOMAIN=mindflow.exemple.fr

# Clé secrète (jetons de session + chiffrement des clés IA / Google).
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Compte démo au premier démarrage (demo@mindflow.app / demo1234) — false en production
SEED_DEMO=false

# Google Calendar (optionnel) — URI de redirection à déclarer : https://DOMAIN/api/oauth/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Clé Anthropic serveur (optionnel : sinon chaque utilisateur met sa clé dans Paramètres)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

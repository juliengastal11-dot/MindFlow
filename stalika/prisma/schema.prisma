generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Modèle d'exemple, remplacé au bootstrap par le schéma du blueprint.
model Contact {
  id        String   @id @default(cuid())
  nom       String
  email     String
  message   String
  createdAt DateTime @default(now())
}

// Conservé à CHAQUE bootstrap, quel que soit le schéma du blueprint :
// `lib/reglages.ts` en dépend. Le socle doit compiler seul : ce qu'un de ses
// fichiers suppose, un autre le déclare. Trouvé par un clone dans un dossier
// vide : chaque projet réparait cette contradiction sans le savoir.
model Reglage {
  cle       String   @id
  valeur    String
  updatedAt DateTime @updatedAt
}

// --- Module auth (Auth.js v5 + Prisma), greffe du bootstrap -----------------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          String    @default("user")
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
